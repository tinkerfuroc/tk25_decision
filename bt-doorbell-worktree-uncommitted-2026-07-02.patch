+class BtNode_Doorbell(ActionHandler):
+    """
+    Action-client node for tk_24_audio's `doorbell_action`
+    (tinker_audio_msgs/action/Doorbell).
+
+    Listens for a doorbell sound matching a stored template via normalized
+    cross-correlation. The server uses a fixed 10s listen window (Goal has
+    no fields). Returns SUCCESS when the doorbell is detected, FAILURE on
+    timeout / error / cancel.
+
+    If `bb_dest_key` is provided, the result `transcription` string
+    (e.g. "Doorbell detected (correlation=0.42)") is written there.
+    """
+
+    def __init__(
+        self,
+        name: str,
+        bb_dest_key: Optional[str] = None,
+        action_name: str = "doorbell_action",
+        wait_for_server_timeout_sec: float = -3.0,
+    ):
+        super().__init__(
+            name,
+            DoorbellAction,
+            action_name,
+            key=None,
+            wait_for_server_timeout_sec=wait_for_server_timeout_sec,
+        )
+        # Server hardcodes LISTEN_TIMEOUT=10s; allow generous feedback margin.
+        self._feedback_timeout_secs = 30.0
+        self.bb_dest_key = bb_dest_key
+        self._bb = None
+        if bb_dest_key is not None:
+            self._bb = self.attach_blackboard_client(
+                name=f"{self.name}_DoorbellAction"
+            )
+            self._bb.register_key(
+                key="transcription",
+                access=pytree.common.Access.WRITE,
+                remap_to=pytree.blackboard.Blackboard.absolute_name(
+                    "/", bb_dest_key
+                ),
+            )
+
+    def send_goal(self):
+        if self.mock_mode:
+            mock_msg = "Doorbell detected (mock)"
+            if self._bb is not None:
+                self._bb.transcription = mock_msg
+            self.feedback_message = "MOCK: Doorbell goal sent"
+            print(f"🔔 MOCK DOORBELL (action): '{mock_msg}'")
+            self.send_goal_future = _MockFuture()
+            return
+        goal = DoorbellAction.Goal()
+        self.send_goal_request(goal)
+        self.feedback_message = "sent Doorbell goal"
+
+    def feedback_callback(self, msg):
+        feedback = msg.feedback
+        self.last_feedback_time = time.time()
+        self.feedback_timeout = self._feedback_timeout_secs
+        self.action_status = 0
+        elapsed = getattr(feedback, "elapsed", 0.0)
+        partial = getattr(feedback, "partial_transcription", "")
+        self.feedback_message = (
+            f"doorbell elapsed={elapsed:.1f}s"
+            + (f" [partial: '{partial}']" if partial else "")
+        )
+
+    def process_result(self):
+        if self.result_status != action_msgs.GoalStatus.STATUS_SUCCEEDED:
+            result = getattr(self.result_message, "result", None)
+            status = getattr(result, "status", -1)
+            err = getattr(result, "error_message", "")
+            self.feedback_message = (
+                f"Doorbell action did not succeed "
+                f"(action={self.result_status_string}, server status={status}): {err}"
+            )
+            return Status.FAILURE
+        result = self.result_message.result
+        if getattr(result, "status", 0) != 0:
+            self.feedback_message = (
+                f"Doorbell failed with code {result.status}: "
+                f"{getattr(result, 'error_message', '')}"
+            )
+            return Status.FAILURE
+        transcription = getattr(result, "transcription", "")
+        if self._bb is not None:
+            self._bb.transcription = transcription
+        self.feedback_message = f"Doorbell detected: '{transcription}'"
+        return Status.SUCCESS
