digraph gpsr_cmd_understanding {
  rankdir=LR;
  graph [fontname="Helvetica", labelloc="t", label="GPSR command understanding — 20 commands"];
  node  [fontname="Helvetica", shape=box, style="rounded,filled"];
  edge  [fontname="Helvetica", fontsize=10];

  subgraph cluster_1 {
    label="01. escort Alex from the bathroom to the bedroom — OK (3 steps)";
    style=filled; color="#d6ffd6";
    node [fillcolor=white];
    n1_0 [label="goto\\nlocation=bathroom", fillcolor=white];
    n1_1 [label="find_person\\ndescriptor=Alex", fillcolor=white];
    n1_0 -> n1_1;
    n1_2 [label="guide\\nlocation=bedroom", fillcolor=white];
    n1_1 -> n1_2;
  }

  subgraph cluster_2 {
    label="02. navigate to the desk_lamp then look for a pear and fetch it and put it on the shelf — OK (5 steps)";
