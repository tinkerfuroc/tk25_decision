  subgraph cluster_17 {
    label="17. locate a drink in the kitchen then take it and throw it in the trash — OK (3 steps)";
    style=filled; color="#d6ffd6";
    node [fillcolor=white];
    n17_0 [label="find_object\\nobject=drink\\nlocation=kitchen", fillcolor=white];
